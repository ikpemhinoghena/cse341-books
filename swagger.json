{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Retrieve all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "All books without MongoDB _id or the legacy author field; an empty collection returns []; ordering is not guaranteed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                },
                "examples": {
                  "books": {
                    "value": [
                      {
                        "id": "b4",
                        "authorId": "a1",
                        "title": "Example Book Title",
                        "publicationDate": "2026-01-15"
                      }
                    ]
                  },
                  "empty": {
                    "value": []
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Internal server error"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "tags": [
          "Books"
        ],
        "description": "Requires a JSON object with id, authorId, title, and publicationDate. Rejects missing, null, blank, incorrectly typed or unknown fields, malformed JSON, and missing or incorrect Content-Type. Preserves accepted strings without trimming or case changes. Validates the body, then duplicate ID, then author existence. A unique case-sensitive index prevents duplicate IDs, including concurrent requests.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              },
              "example": {
                "id": "b4",
                "authorId": "a1",
                "title": "Example Book Title",
                "publicationDate": "2026-01-15"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created book without MongoDB _id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                },
                "example": {
                  "id": "b4",
                  "authorId": "a1",
                  "title": "Example Book Title",
                  "publicationDate": "2026-01-15"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected without writing book data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Invalid book data",
                        "Book id already exists",
                        "Author not found"
                      ]
                    }
                  }
                },
                "examples": {
                  "error1": {
                    "value": {
                      "message": "Invalid book data"
                    }
                  },
                  "error2": {
                    "value": {
                      "message": "Book id already exists"
                    }
                  },
                  "error3": {
                    "value": {
                      "message": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Internal server error"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Retrieve a book by custom ID",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Exact, case-sensitive custom book ID; not a MongoDB ObjectId",
            "schema": {
              "type": "string"
            },
            "example": "b4"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching book with authorId and without MongoDB _id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                },
                "example": {
                  "id": "b4",
                  "authorId": "a1",
                  "title": "Example Book Title",
                  "publicationDate": "2026-01-15"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Book not found"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Internal server error"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update an existing book",
        "tags": [
          "Books"
        ],
        "description": "Requires authorId, title, and publicationDate in a JSON object. Optional id must exactly match the URL and is never changed. Rejects missing, null, blank, incorrectly typed or unknown fields, malformed JSON, and missing or incorrect Content-Type. Validates the body, then book existence, then author existence. Never inserts a missing book. Unchanged valid values return 200. Accepted strings are preserved.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Exact, case-sensitive custom book ID; not a MongoDB ObjectId",
            "schema": {
              "type": "string"
            },
            "example": "b4"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "authorId",
                  "title",
                  "publicationDate"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "Immutable custom string ID, compared exactly and case-sensitively",
                    "example": "b4"
                  },
                  "authorId": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "Custom ID of an existing author",
                    "example": "a1"
                  },
                  "title": {
                    "type": "string",
                    "pattern": "\\S",
                    "example": "Example Book Title"
                  },
                  "publicationDate": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "description": "A real calendar date in YYYY-MM-DD format with year 0001 through 9999; future dates are allowed",
                    "example": "2026-01-15"
                  }
                }
              },
              "example": {
                "authorId": "a2",
                "title": "Updated Book Title",
                "publicationDate": "2026-02-20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated book with its original ID, excluding MongoDB _id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                },
                "example": {
                  "id": "b4",
                  "authorId": "a2",
                  "title": "Updated Book Title",
                  "publicationDate": "2026-02-20"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected without writing book data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Invalid book data",
                        "Author not found"
                      ]
                    }
                  }
                },
                "examples": {
                  "error1": {
                    "value": {
                      "message": "Invalid book data"
                    }
                  },
                  "error2": {
                    "value": {
                      "message": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Book not found"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Internal server error"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a book",
        "tags": [
          "Books"
        ],
        "description": "Deletes only the matching book. Author documents remain unchanged. Returns 404 if no document is deleted.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Exact, case-sensitive custom book ID; not a MongoDB ObjectId",
            "schema": {
              "type": "string"
            },
            "example": "b4"
          }
        ],
        "responses": {
          "204": {
            "description": "Book deleted; no response body"
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Book not found"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Internal server error"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Retrieve all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "An array of authors, or an empty array when none exist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "birthYear"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "birthYear": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Birth year no later than the current UTC calendar year"
                      }
                    }
                  }
                },
                "example": [
                  {
                    "id": "a1",
                    "name": "Maya Rivera",
                    "birthYear": 1985
                  }
                ]
              }
            }
          },
          "500": {
            "description": "An unexpected server or database error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Internal server error"
                      ]
                    }
                  }
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an author",
        "tags": [
          "Authors"
        ],
        "description": "Requires a JSON object with only id, name, and birthYear. Rejects missing, null, blank, or incorrectly typed fields, malformed JSON, missing or incorrect Content-Type, and unknown fields. Valid strings are preserved without trimming. A unique case-sensitive index prevents duplicate IDs, including concurrent requests.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Author"
              },
              "example": {
                "id": "a1",
                "name": "Maya Rivera",
                "birthYear": 1985
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created author without MongoDB _id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                },
                "example": {
                  "id": "a1",
                  "name": "Maya Rivera",
                  "birthYear": 1985
                }
              }
            }
          },
          "400": {
            "description": "Invalid author data or duplicate custom ID; no author is created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "Invalid author data",
                        "Author id already exists"
                      ]
                    }
                  }
                },
                "examples": {
                  "invalid": {
                    "value": {
                      "message": "Invalid author data"
                    }
                  },
                  "duplicate": {
                    "value": {
                      "message": "Author id already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server or database error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Retrieve an author by custom ID",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Exact, case-sensitive custom author ID",
            "schema": {
              "type": "string"
            },
            "example": "a1"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching author, excluding MongoDB _id and other internal fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                },
                "example": {
                  "id": "a1",
                  "name": "Maya Rivera",
                  "birthYear": 1985
                }
              }
            }
          },
          "404": {
            "description": "No author matches the custom ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Author not found"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server or database error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update an existing author",
        "tags": [
          "Authors"
        ],
        "description": "Requires name and birthYear in a JSON object. Optional id must exactly match the URL and is never changed. Rejects missing, null, blank, incorrectly typed or unknown fields, malformed JSON, and missing or incorrect Content-Type. Validates before checking existence. Never inserts a missing author. Unchanged valid values return 200. Existing book references remain unchanged.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Exact, case-sensitive custom author ID",
            "schema": {
              "type": "string"
            },
            "example": "a1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "birthYear"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "Immutable custom string ID, compared exactly and case-sensitively",
                    "example": "a1"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "\\S",
                    "example": "Maya Rivera"
                  },
                  "birthYear": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Integer no later than the current UTC calendar year; numeric strings are rejected",
                    "example": 1985
                  }
                }
              },
              "example": {
                "name": "Maya L. Rivera",
                "birthYear": 1986
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated author with its original ID and without MongoDB _id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                },
                "example": {
                  "id": "a1",
                  "name": "Maya L. Rivera",
                  "birthYear": 1986
                }
              }
            }
          },
          "400": {
            "description": "Invalid author data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Invalid author data"
                }
              }
            }
          },
          "404": {
            "description": "No author matches the custom ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Author not found"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server or database error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an unreferenced author",
        "tags": [
          "Authors"
        ],
        "description": "Checks author existence before book references. Rejects deletion while any book authorId matches the author ID. Never modifies or deletes books. Reassign or delete referencing books before retrying. Separate checks do not guarantee reference integrity during concurrent book writes and author deletion.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Exact, case-sensitive custom author ID",
            "schema": {
              "type": "string"
            },
            "example": "a1"
          }
        ],
        "responses": {
          "204": {
            "description": "Author deleted; no response body"
          },
          "404": {
            "description": "No author matches the custom ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Author not found"
                }
              }
            }
          },
          "409": {
            "description": "Books still reference this author; all records remain unchanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Cannot delete author while books reference this author"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server or database error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "required": [
          "id",
          "authorId",
          "title",
          "publicationDate"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S",
            "description": "Immutable custom string ID, compared exactly and case-sensitively",
            "example": "b4"
          },
          "authorId": {
            "type": "string",
            "pattern": "\\S",
            "description": "Custom ID of an existing author",
            "example": "a1"
          },
          "title": {
            "type": "string",
            "pattern": "\\S",
            "example": "Example Book Title"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "A real calendar date in YYYY-MM-DD format with year 0001 through 9999; future dates are allowed",
            "example": "2026-01-15"
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "id",
          "name",
          "birthYear"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S",
            "description": "Immutable custom string ID, compared exactly and case-sensitively",
            "example": "a1"
          },
          "name": {
            "type": "string",
            "pattern": "\\S",
            "example": "Maya Rivera"
          },
          "birthYear": {
            "type": "integer",
            "minimum": 1,
            "description": "Integer no later than the current UTC calendar year; numeric strings are rejected",
            "example": 1985
          }
        }
      },
      "AuthorError": {
        "type": "object",
        "required": [
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": []
}